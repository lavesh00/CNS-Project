{
  "name": "Agent Lucky Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1e1e1e",
    "editor.foreground": "#d4d4d4",
    "editorLineNumber.foreground": "#858585",
    "editorLineNumber.activeForeground": "#c6c6c6",
    "editor.selectionBackground": "#264f78",
    "editor.inactiveSelectionBackground": "#3a3d41",
    "editorCursor.foreground": "#007acc",
    "editor.lineHighlightBackground": "#2a2a2a",
    
    "activityBar.background": "#181818",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#858585",
    "activityBar.border": "#2b2b2b",
    "activityBarBadge.background": "#007acc",
    "activityBarBadge.foreground": "#ffffff",
    
    "sideBar.background": "#181818",
    "sideBar.foreground": "#cccccc",
    "sideBar.border": "#2b2b2b",
    "sideBarTitle.foreground": "#ffffff",
    "sideBarSectionHeader.background": "#252526",
    "sideBarSectionHeader.foreground": "#ffffff",
    
    "statusBar.background": "#007acc",
    "statusBar.foreground": "#ffffff",
    "statusBar.noFolderBackground": "#68217a",
    "statusBar.debuggingBackground": "#cc6633",
    "statusBarItem.hoverBackground": "#0098ff",
    
    "panel.background": "#1e1e1e",
    "panel.border": "#2b2b2b",
    "panelTitle.activeBorder": "#007acc",
    "panelTitle.activeForeground": "#ffffff",
    "panelTitle.inactiveForeground": "#858585",
    
    "titleBar.activeBackground": "#181818",
    "titleBar.activeForeground": "#cccccc",
    "titleBar.inactiveBackground": "#181818",
    "titleBar.inactiveForeground": "#858585",
    "titleBar.border": "#2b2b2b",
    
    "button.background": "#007acc",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#0098ff",
    
    "input.background": "#2b2b2b",
    "input.border": "#3a3a3a",
    "input.foreground": "#cccccc",
    "input.placeholderForeground": "#858585",
    
    "dropdown.background": "#2b2b2b",
    "dropdown.border": "#3a3a3a",
    "dropdown.foreground": "#cccccc",
    
    "list.activeSelectionBackground": "#007acc",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#3a3d41",
    "list.hoverBackground": "#2a2d2e",
    "list.focusBackground": "#007acc",
    "list.focusForeground": "#ffffff",
    
    "badge.background": "#007acc",
    "badge.foreground": "#ffffff",
    
    "progressBar.background": "#007acc",
    
    "terminal.background": "#1e1e1e",
    "terminal.foreground": "#d4d4d4",
    
    "gitDecoration.modifiedResourceForeground": "#d7ba7d",
    "gitDecoration.deletedResourceForeground": "#f48771",
    "gitDecoration.untrackedResourceForeground": "#89d185",
    "gitDecoration.conflictingResourceForeground": "#e51400"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6a9955"
      }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": {
        "foreground": "#ce9178"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#569cd6"
      }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#dcdcaa"
      }
    },
    {
      "scope": ["entity.name.type", "entity.name.class"],
      "settings": {
        "foreground": "#4ec9b0"
      }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": {
        "foreground": "#9cdcfe"
      }
    },
    {
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#b5cea8"
      }
    }
  ]
}

