{
  "name": "agent-lucky",
  "displayName": "Agent Lucky",
  "description": "Agentic AI coding assistant with local models",
  "version": "1.0.0",
  "publisher": "agent-lucky",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agent-lucky.startAgent",
        "title": "Agent Lucky: Start Agent",
        "icon": "$(rocket)"
      },
      {
        "command": "agent-lucky.showPanel",
        "title": "Agent Lucky: Show Panel",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agent-lucky.checkStatus",
        "title": "Agent Lucky: Check Status"
      },
      {
        "command": "agent-lucky.listModels",
        "title": "Agent Lucky: List Models"
      },
      {
        "command": "agent-lucky.downloadModel",
        "title": "Agent Lucky: Download Model"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-lucky",
          "title": "Agent Lucky",
          "icon": "$(rocket)"
        }
      ]
    },
    "views": {
      "agent-lucky": [
        {
          "id": "agentLuckyPanel",
          "name": "Agent Panel",
          "type": "webview"
        },
        {
          "id": "agentLuckyPlan",
          "name": "Plan / TODOs"
        },
        {
          "id": "agentLuckyModels",
          "name": "Models"
        }
      ]
    },
    "configuration": {
      "title": "Agent Lucky",
      "properties": {
        "agentLucky.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:7777",
          "description": "Agent Lucky backend URL"
        },
        "agentLucky.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start backend on VS Code launch"
        },
        "agentLucky.defaultModel": {
          "type": "string",
          "default": "codellama-13b-q4",
          "description": "Default model to use"
        }
      }
    }
  },
  "scripts": {
    "lint": "echo 'No linting configured'",
    "test": "echo 'No tests configured'"
  },
  "devDependencies": {},
  "dependencies": {
    "axios": "^1.6.0"
  }
}
